# Public site URL (used in metadata, sitemap, robots, JSON-LD)
# Falls back to https://superdecor.ro defined in src/lib/site.ts
NEXT_PUBLIC_SITE_URL=https://superdecor.ro

# Contact form: sent through the contact@superdecor.ro mailbox (SMTP)
# Without SMTP_PASS the form opens the visitor's mail app instead
# SMTP_PASS=
# Optional overrides (defaults shown)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@superdecor.ro
# CONTACT_TO=office@superdecor.ro

# Optional Google verification (for Search Console)
# GOOGLE_SITE_VERIFICATION=

# Optional Google Tag Manager ID (if used in addition to Vercel Analytics)
# NEXT_PUBLIC_GTM_ID=
